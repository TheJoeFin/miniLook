<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="miniLook.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:miniLook.Models"
    x:Name="RootPage"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolNegationConverter x:Key="BoolNegation" />
    </Page.Resources>

    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Button
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Back to calendar"
                    Command="{x:Bind ViewModel.CancelEditCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                    Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Grid
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE787;"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Refresh calendar"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.RefreshCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                ToolTipService.ToolTip="Refresh calendar"
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="3"
                Height="32"
                AutomationProperties.Name="Create event"
                Click="NewEventButton_Click"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="New" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button
                    Command="{x:Bind ViewModel.SignInCommand}"
                    Content="Sign in"
                    Visibility="{x:Bind ViewModel.NeedsSignIn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <Grid Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
                <Grid>
                    <ListView
                        Margin="0,0,-12,0"
                        Padding="0,0,12,0"
                        AutomationProperties.Name="Upcoming events"
                        IsItemClickEnabled="True"
                        ItemClick="CalendarList_ItemClick"
                        ItemsSource="{x:Bind GroupedEvents.View, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:CalendarEventDayGroup">
                                        <TextBlock
                                            Margin="0,12,0,2"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Label, Mode=OneTime}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarEventItem">
                                <Border
                                    Padding="12"
                                    AutomationProperties.Name="{x:Bind AccessibilityLabel, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Subject, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE823;" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind DisplayTime, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind HasLocation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE707;" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Location, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <HyperlinkButton
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Join meeting"
                                            Click="OpenMeetingButton_Click"
                                            Tag="{x:Bind MeetingLink, Mode=OneWay}"
                                            ToolTipService.ToolTip="Join meeting"
                                            Visibility="{x:Bind HasMeetingLink, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="14" Glyph="&#xE714;" />
                                                <TextBlock Text="Join" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        MaxWidth="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasEvents, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE787;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No events in the next 30 days."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </Grid>
            </Grid>

            <Grid Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Margin="0,0,-12,0"
                    Padding="0,0,12,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" />
                        <TextBox
                            AcceptsReturn="False"
                            Header="Subject"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            MaxLength="255"
                            PlaceholderText="Event title"
                            Text="{x:Bind ViewModel.EventSubject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ToggleSwitch
                            Header="All-day event"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            IsOn="{x:Bind ViewModel.IsAllDay, Mode=TwoWay}" />
                        <DatePicker
                            Header="Start date"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
                        <TimePicker
                            Header="Start time"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            SelectedTime="{x:Bind ViewModel.StartTime, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}" />
                        <DatePicker
                            Header="End date"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" />
                        <TimePicker
                            Header="End time"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            SelectedTime="{x:Bind ViewModel.EndTime, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="For all-day events, the end date is exclusive."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox
                            Header="Location"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            PlaceholderText="Optional"
                            Text="{x:Bind ViewModel.EventLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            MinHeight="88"
                            AcceptsReturn="True"
                            Header="Notes"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                            PlaceholderText="Optional"
                            Text="{x:Bind ViewModel.EventBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Row="1"
                    Padding="0,12,0,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        AutomationProperties.Name="Delete event"
                        Click="DeleteEditingEventButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                        ToolTipService.ToolTip="Delete event"
                        Visibility="{x:Bind ViewModel.IsExistingEvent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE74D;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegation}}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
