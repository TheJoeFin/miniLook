<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="miniLook.Views.ListDetailsDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:miniLook.Models"
    xmlns:tc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="boolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            Margin="8,0"
            Background="Transparent"
            DefaultLabelPosition="Collapsed">
            <CommandBar.Content>
                <Button
                    x:Name="MessageDetailsButton"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Message details"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Show sender, recipients, and received time">
                    <Grid ColumnSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ListDetailsMenuItem.SenderDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE70D;" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ListDetailsMenuItem.RelativeReceivedDateTime, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <ScrollViewer MaxWidth="300" MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="From" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ListDetailsMenuItem.SenderDisplayName, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ListDetailsMenuItem.SenderAddress, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" Visibility="{x:Bind ListDetailsMenuItem.HasToRecipients, Mode=OneWay, Converter={StaticResource boolToVisibility}}">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="To" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ListDetailsMenuItem.ToRecipientsFull, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" Visibility="{x:Bind ListDetailsMenuItem.HasCcRecipients, Mode=OneWay, Converter={StaticResource boolToVisibility}}">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="CC" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ListDetailsMenuItem.CcRecipientsFull, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Received" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind ListDetailsMenuItem.FormattedReceivedDateTime, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </CommandBar.Content>
            <AppBarButton
                AutomationProperties.Name="Reply"
                Click="ReplyHyperlinkButton_Click"
                Icon="MailReply"
                Label="Reply"
                ToolTipService.ToolTip="Reply (Ctrl+R)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Click="ForwardHyperlinkButton_Click"
                    Icon="MailForward"
                    Label="Forward"
                    ToolTipService.ToolTip="Forward (Ctrl+F)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="MarkReadHyperlinkButton_Click"
                    Label="Mark Read"
                    ToolTipService.ToolTip="Mark as Read (Ctrl+Q)"
                    Visibility="{x:Bind ListDetailsMenuItem.IsRead, Mode=OneWay, Converter={StaticResource boolToVisibility}, ConverterParameter=true}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8C3;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="MarkUnreadHyperlinkButton_Click"
                    Label="Mark Unread"
                    ToolTipService.ToolTip="Mark as Unread (Ctrl+U)"
                    Visibility="{x:Bind ListDetailsMenuItem.IsRead, Mode=OneWay, Converter={StaticResource boolToVisibility}}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="U" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="ArchiveHyperlinkButton_Click"
                    Label="Archive"
                    ToolTipService.ToolTip="Archive (Del)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    Click="DeleteHyperlinkButton_Click"
                    Icon="Delete"
                    Label="Delete"
                    ToolTipService.ToolTip="Delete (Shift+Del)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    Click="PopOutButton_Click"
                    Label="Pop out"
                    ToolTipService.ToolTip="Open this email in a new window">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="NewWindow" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="BodyViewButton"
                    Click="BodyViewButton_Click"
                    Label="HTML view"
                    Visibility="{x:Bind ListDetailsMenuItem.HasHtmlBody, Mode=OneWay, Converter={StaticResource boolToVisibility}}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!--  Attachments strip  -->
        <ItemsControl
            x:Name="AttachmentsPanel"
            Grid.Row="1"
            Padding="16,6,16,6"
            ItemsSource="{x:Bind ListDetailsMenuItem.Attachments, Mode=OneWay}"
            Visibility="{x:Bind ListDetailsMenuItem.HasAttachments, Mode=OneWay, Converter={StaticResource boolToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <tc:WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AttachmentInfo">
                    <Button
                        Margin="0,0,6,4"
                        Padding="8,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Click="AttachmentButton_Click"
                        CornerRadius="6"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind Name}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                MaxWidth="180"
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Body: plain text view (shown by default)  -->
        <ScrollViewer
            x:Name="BodyScrollViewer"
            Grid.Row="2"
            Padding="16,10,16,16">
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{StaticResource DetailBodyStyle}"
                Text="{x:Bind ListDetailsMenuItem.Body, Mode=OneWay}"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <!--  Body: HTML web view  -->
        <Grid
            x:Name="WebViewPane"
            Grid.Row="2"
            Visibility="Collapsed">
            <WebView2
                x:Name="BodyWebView"
                CoreWebView2Initialized="BodyWebView_CoreWebView2Initialized" />
        </Grid>

    </Grid>
</UserControl>
